{
  "version": 2,
  "title": "Connect your AI",
  "description": "Use your own Gyri sign-in to explore this workspace through MCP.",
  "accent": "sage",
  "data": {
    "viewer": {
      "kind": "graphql",
      "query": "query FieldworkConnectionWorkspace { viewerContext { workspaceId } }",
      "valuePath": "viewerContext"
    }
  },
  "actions": [
    {
      "id": "copy_mcp_url",
      "type": "copyToClipboard",
      "target": {
        "text": "https://mcp.gyri.io/mcp"
      },
      "onSuccess": {
        "toast": "MCP URL copied"
      }
    }
  ],
  "root": {
    "id": "connect",
    "kind": "Stack",
    "props": {
      "className": "max-w-4xl"
    },
    "children": [
      {
        "id": "mcp_connection",
        "kind": "Section",
        "props": {
          "title": "1. Add Gyri to your AI app"
        },
        "children": [
          {
            "id": "connection_intro",
            "kind": "Text",
            "props": {
              "value": "Accept your Gyri workspace invitation first. Then, in an AI app that supports remote MCP, add a server named Gyri and paste the URL below into its MCP server settings.",
              "className": "text-base leading-7"
            }
          },
          {
            "id": "active_workspace",
            "kind": "Text",
            "props": {
              "value": "Current workspace: {{data.viewer.workspaceId}}",
              "className": "text-base font-semibold"
            }
          },
          {
            "id": "workspace_mcp_url",
            "kind": "Text",
            "props": {
              "value": "https://mcp.gyri.io/mcp",
              "className": "select-all break-all rounded-lg bg-slate-50 p-4 font-mono text-base"
            },
            "visibleWhen": "{{data.viewer.workspaceId}}"
          },
          {
            "id": "copy_url",
            "kind": "Button",
            "props": {
              "label": "Copy MCP URL",
              "variant": "primary"
            },
            "action": "copy_mcp_url",
            "visibleWhen": "{{data.viewer.workspaceId}}"
          },
          {
            "id": "url_hint",
            "kind": "Text",
            "props": {
              "value": "This is Gyri’s canonical MCP address. The workspace you choose during sign-in and OAuth consent determines which workspace the connection can access.",
              "className": "text-sm leading-6"
            }
          }
        ]
      },
      {
        "id": "consent",
        "kind": "Section",
        "props": {
          "title": "2. Sign in and allow only this workspace"
        },
        "children": [
          {
            "id": "consent_steps",
            "kind": "Text",
            "props": {
              "value": "Sign in with the same Gyri account that accepted your workspace invitation. Select the current workspace shown above. Choose “Only this workspace” during consent and approve the connection.",
              "className": "text-base leading-7"
            }
          },
          {
            "id": "own_identity",
            "kind": "Text",
            "props": {
              "value": "Use your own sign-in. You do not need the workspace owner’s API key, a shared credential or a new invitation. The connection keeps your assigned workspace permissions.",
              "className": "text-base leading-7"
            }
          },
          {
            "id": "deployment_name",
            "kind": "Text",
            "props": {
              "value": "This Coffee & Counter deployment is in the Overture Fieldwork workspace (overture-fieldwork). If another workspace is shown above, return to Coffee & Counter before connecting.",
              "className": "text-sm leading-6"
            }
          }
        ]
      },
      {
        "id": "first_question",
        "kind": "Section",
        "props": {
          "title": "3. Start with the evidence"
        },
        "children": [
          {
            "id": "first_prompt",
            "kind": "Text",
            "props": {
              "value": "Show me the place types, connected public data sources and graph relationships in this workspace. Then find a few coffee shops or bakeries I could research. Keep source facts separate from candidate matches and team decisions.",
              "className": "rounded-lg bg-slate-50 p-4 text-base leading-7"
            }
          },
          {
            "id": "read_access",
            "kind": "Text",
            "props": {
              "value": "Read-only reviewers can inspect records and metadata. Saving notes, configuring sources or changing the graph requires the relevant write permission; connecting an AI does not expand your role.",
              "className": "text-base leading-7"
            }
          }
        ]
      },
      {
        "id": "discover",
        "kind": "Section",
        "props": {
          "title": "Explore what powers the app"
        },
        "children": [
          {
            "id": "places_link",
            "kind": "Link",
            "props": {
              "label": "Explore places",
              "href": "/pages/fieldwork?kb_ws={{data.viewer.workspaceId}}",
              "className": "text-base"
            }
          },
          {
            "id": "sources_link",
            "kind": "Link",
            "props": {
              "label": "HTTP connectors and public source operations",
              "href": "/connectors?kb_ws={{data.viewer.workspaceId}}",
              "className": "text-base"
            }
          },
          {
            "id": "types_link",
            "kind": "Link",
            "props": {
              "label": "Data types and saved records",
              "href": "/custom-data?kb_ws={{data.viewer.workspaceId}}",
              "className": "text-base"
            }
          },
          {
            "id": "graph_link",
            "kind": "Link",
            "props": {
              "label": "Graph model and relationships",
              "href": "/semantic?tab=bridges&kb_ws={{data.viewer.workspaceId}}",
              "className": "text-base"
            }
          },
          {
            "id": "method_link",
            "kind": "Link",
            "props": {
              "label": "Sources & method",
              "href": "/dashboards/fieldwork_method?kb_ws={{data.viewer.workspaceId}}",
              "className": "text-base"
            }
          }
        ]
      }
    ]
  }
}
