  "dashboards": [
    {
      "slug": "fieldwork_home",
      "name": "Partner research desk",
      "description": "A place-based research queue for wholesale roasters, bakery suppliers, and neighborhood partnership teams.",
      "definition": {
        "version": 1,
        "title": "Your partner research desk",
        "description": "A place-based research queue for wholesale roasters, bakery suppliers, and neighborhood partnership teams.",
        "tiles": [
          {
            "id": "intro",
            "kind": "text",
            "title": "From a map pin to a useful conversation",
            "content": "Start with a real venue, keep the evidence, make a deliberate shortlist.\n\nChoose Explore places in the sidebar to find a venue. Open its row to inspect the website, map location and source evidence. Use Update review status to shortlist it, or Replace research notes to save what your team learned. Editors can save changes; invited reviewers have read-only access.\n\nYour shortlist appears below once an editor saves a shortlisted decision. A shortlist is a research decision, not evidence of buying intent or supplier fit.",
            "layout": {
              "x": 0,
              "y": 0,
              "w": 12,
              "h": 4
            },
            "style": {
