{
  "schemaVersion": 2,
  "moduleId": "gyri.module:overture-fieldwork",
  "name": "Overture Fieldwork — Coffee & Counter",
  "description": "A shared research desk that turns open place data into an evidence-backed neighborhood partner shortlist.",
  "version": "0.1.0",
  "tags": [
    "capability",
    "places",
    "overture",
    "field-research",
    "partnerships"
  ],
  "integrations": [],
  "customTypes": [
    {
      "typeKey": "fieldwork_place",
      "displayName": "Fieldwork place",
      "storage": "kb",
      "fieldSchema": {
        "description": "A team-owned research queue for physical places. Source observations stay separate from team review, notes and next actions. Initial adapter: Overture Maps places.",
        "fields": [
          {
            "name": "overture_id",
            "type": "string",
            "required": true,
            "description": "Source identity from Overture GERS. Never replace this with a name-based identity."
          },
          {
            "name": "name",
            "type": "string",
            "required": true
          },
          {
            "name": "category",
            "type": "string"
          },
          {
            "name": "category_label",
            "type": "string"
          },
          {
            "name": "basic_category",
            "type": "string"
          },
          {
            "name": "category_hierarchy",
            "type": "json"
          },
          {
            "name": "latitude",
            "type": "number"
          },
          {
            "name": "longitude",
            "type": "number"
          },
          {
            "name": "address",
            "type": "string"
          },
          {
            "name": "full_address",
            "type": "string"
          },
          {
            "name": "locality",
            "type": "string"
          },
          {
            "name": "region",
            "type": "string"
          },
          {
            "name": "postcode",
            "type": "string"
          },
          {
            "name": "country",
            "type": "string"
          },
          {
            "name": "website",
            "type": "string"
          },
          {
            "name": "website_available",
            "type": "boolean",
            "description": "A website URL appears in the source; this is not a live reachability check."
          },
          {
            "name": "websites",
            "type": "json"
          },
          {
            "name": "phones",
            "type": "json"
          },
          {
            "name": "socials",
            "type": "json"
          },
          {
            "name": "brand",
            "type": "string",
            "description": "Only the brand supplied by the source. Empty does not imply independent ownership."
          },
          {
            "name": "operating_status",
            "type": "string",
            "description": "Source operating status, not a live verification."
          },
          {
            "name": "confidence",
            "type": "number",
            "description": "Overture confidence that a place exists; not a partner-fit, quality, or open-now score."
          },
          {
            "name": "data_release",
            "type": "string",
            "required": true
          },
          {
            "name": "overture_version",
            "type": "number"
          },
          {
            "name": "sources",
            "type": "json"
          },
          {
            "name": "source_datasets",
            "type": "json"
          },
          {
            "name": "source_licenses",
            "type": "json"
          },
          {
            "name": "source_url",
            "type": "string"
          },
          {
            "name": "map_url",
            "type": "string"
          },
          {
            "name": "review_status",
            "type": "string",
            "required": true,
            "allowedValues": [
              "unreviewed",
              "verify_first",
              "shortlisted",
              "visited",
              "passed"
            ],
            "description": "Team decision only. Imports start unreviewed; shortlisted means worth researching, not verified fit."
          },
          {
            "name": "research_notes",
            "type": "string",
            "description": "Human or source-cited research notes. Keep assumptions and observed facts distinct."
          },
          {
            "name": "owner",
            "type": "string",
            "description": "Optional research owner; no external contact is implied."
          },
          {
            "name": "next_action",
            "type": "string",
            "description": "Optional next internal research step."
          },
          {
            "name": "last_verified_at",
            "type": "string",
            "description": "ISO timestamp only after an actual verification; empty on initial import."
          },
          {
            "name": "raw_properties",
            "type": "json",
            "description": "Unmodified source properties for inspection and future re-normalization."
          }
        ],
        "uniqueFields": [
          "overture_id"
        ],
        "summaryFields": [
          "name",
          "category_label",
          "review_status"
        ],
        "keywordIndex": {
          "includeFields": [
            "overture_id",
            "name",
            "category",
            "category_label",
            "basic_category",
            "address",
            "full_address",
            "locality",
            "postcode",
            "website",
            "brand",
            "review_status",
            "research_notes",
            "next_action"
          ],
          "includeRecordId": true,
          "includeAliases": true
        },
        "semanticIndex": {
          "mode": "fields",
          "version": 1,
          "fields": [
            "name",
            "category_label",
            "category_hierarchy",
            "full_address",
            "research_notes",
            "next_action"
          ]
        },
        "contextProfile": {
          "alwaysSurfaceFields": [
            "name",
            "category_label",
            "full_address",
            "review_status",
            "research_notes",
            "website",
            "operating_status",
            "confidence",
            "data_release",
            "sources",
            "overture_id",
            "map_url"
          ]
        },
        "card": {
          "titleField": "name",
          "subtitleFields": [
            "category_label",
            "full_address"
          ],
          "badgeFields": [
            "review_status",
            "operating_status"
          ],
          "actions": [
            {
              "id": "fieldwork_review_status",
              "label": "Update review status",
              "tool": "fieldwork.review_status",
              "arguments": {
                "record_id": "{{row.recordId}}"
              }
            },
            {
              "id": "fieldwork_research_notes",
              "label": "Replace research notes",
              "tool": "fieldwork.research_notes",
              "arguments": {
                "record_id": "{{row.recordId}}"
              }
            }
          ]
        },
        "detail": {
          "layout": "tabs",
          "sections": [
            {
              "id": "place",
              "label": "Place",
              "kind": "profile",
              "fields": [
                "name",
                "category_label",
                "full_address",
                "website",
                "map_url",
                "phones",
                "socials",
                "brand"
              ]
            },
            {
              "id": "review",
              "label": "Team review",
              "kind": "profile",
              "fields": [
                "review_status",
                "research_notes",
                "owner",
                "next_action",
                "last_verified_at"
              ]
            },
            {
              "id": "evidence",
              "label": "Source evidence",
              "kind": "profile",
              "fields": [
                "overture_id",
                "operating_status",
                "confidence",
                "data_release",
                "overture_version",
                "source_url",
                "source_datasets",
                "source_licenses",
                "sources"
              ]
            }
          ]
        },
        "list": {
          "defaultSort": {
            "field": "record_id",
            "order": "asc"
          },
          "defaultLimit": 60,
          "facets": [
            {
              "id": "review",
              "field": "review_status",
              "label": "Review",
              "values": [
                "unreviewed",
                "verify_first",
                "shortlisted",
                "visited",
                "passed"
              ],
              "multi": true
            },
            {
              "id": "category",
              "field": "category_label",
              "label": "Type",
              "multi": true
            },
            {
              "id": "website",
              "field": "website_available",
              "label": "Website listed",
              "values": [
                "true",
                "false"
              ],
              "multi": false
            }
          ],
          "servedFields": [
            "name",
            "category_label",
            "full_address",
            "review_status",
            "website",
            "research_notes",
            "owner",
            "next_action",
            "operating_status",
            "confidence",
            "data_release",
            "overture_id",
            "map_url",
            "sources"
          ],
          "summaries": [
            {
              "id": "total",
              "kind": "count",
              "label": "Places"
            },
            {
              "id": "reviews",
              "kind": "count_by",
              "field": "review_status",
              "label": "Team review"
            }
          ]
        },
        "operatorGuide": "Use this queue to identify potential cafe and counter-service partners for wholesale coffee, bakery supply, or neighborhood collaboration. The category is a discovery signal, never proof of buying intent or supplier fit. Imports must leave review_status=unreviewed and research_notes empty. Preserve source IDs, release, licenses and raw properties. Unknown operating status is unknown; an absent brand is not evidence of independence; a supplied website is not verified. Human review changes only review_status, research_notes, owner, next_action and last_verified_at. A later source refresh must merge source fields while preserving these five team fields. Do not contact a venue, enrich people, enroll campaigns or send outreach from this module. Use map_url to inspect its position. Confirm existence, current website and fit before spending time on a visit."
      }
    }
