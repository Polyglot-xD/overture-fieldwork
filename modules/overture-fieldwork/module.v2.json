            }
          },
          {
            "id": "review_rules",
            "kind": "text",
            "title": "A review status that means something",
            "content": "Unreviewed: source data only. Verify first: a current fact is missing or uncertain. Shortlisted: worth further partner research. Visited: your team actually visited. Passed: your team decided to skip.\n\nWrite the reason in research notes. Leave verification dates empty until checked. This dataset does not guarantee opening hours, ownership, purchasing activity or partnership intent.",
            "layout": {
              "x": 0,
              "y": 9,
              "w": 12,
              "h": 3
            },
            "style": {
              "accent": "neutral"
            }
          }
