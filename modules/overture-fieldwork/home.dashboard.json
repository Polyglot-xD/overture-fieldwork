{
  "version": 1,
  "title": "Coffee & Counter workspace",
  "description": "Source coverage and your team’s research progress.",
  "tiles": [
    {
      "id": "intro",
      "kind": "text",
      "title": "Choose a task, then make a deliberate decision",
      "content": "Explore places brings the map, venue list and source evidence into one workspace.\n\nSupplier prospects: research coffee, cafe and bakery venues before proposing a relevant supply conversation.\nNeighborhood partners: compare public business context while planning an event or collaboration.\nField research: confirm the basics, plan a visit and keep the observations with the place.\n\nUse Team shortlist for selected places and Field visits for internal plans. Category, registration and proximity never prove buying intent or partner fit.",
      "layout": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 4
      },
      "style": {
        "accent": "sage",
        "emphasis": "strong"
      }
    },
    {
      "id": "places",
      "kind": "stat",
      "title": "Places in this workspace",
      "dataSource": {
        "kind": "workspace_record_count",
        "typeKey": "fieldwork_place"
      },
      "layout": {
        "x": 0,
        "y": 4,
        "w": 3,
        "h": 1
      },
      "style": {
        "accent": "neutral"
      }
    },
    {
      "id": "unreviewed",
      "kind": "stat",
      "title": "Still unreviewed",
      "dataSource": {
        "kind": "workspace_record_count",
        "typeKey": "fieldwork_place",
        "filters": {
          "review_status": "unreviewed"
        }
      },
      "layout": {
        "x": 3,
        "y": 4,
        "w": 3,
        "h": 1
      },
      "style": {
        "accent": "sky"
      }
    },
    {
      "id": "shortlisted",
      "kind": "stat",
      "title": "Team shortlist",
      "dataSource": {
        "kind": "workspace_record_count",
        "typeKey": "fieldwork_place",
        "filters": {
          "review_status": "shortlisted"
        }
      },
      "layout": {
        "x": 6,
        "y": 4,
        "w": 3,
        "h": 1
      },
      "style": {
        "accent": "sage"
      }
    },
    {
      "id": "verify",
      "kind": "stat",
      "title": "Verify first",
      "dataSource": {
        "kind": "workspace_record_count",
        "typeKey": "fieldwork_place",
        "filters": {
          "review_status": "verify_first"
        }
      },
      "layout": {
        "x": 9,
        "y": 4,
        "w": 3,
        "h": 1
      },
      "style": {
        "accent": "rose"
      }
    },
    {
      "id": "shortlist",
      "kind": "table",
      "title": "Your shortlist — empty until you decide",
      "dataSource": {
        "kind": "workspace_records",
        "typeKey": "fieldwork_place",
        "filters": {
          "review_status": "shortlisted"
        },
        "limit": 100
      },
      "columns": [
        {
          "field": "name",
          "label": "Place"
        },
        {
          "field": "category_label",
          "label": "Type"
        },
        {
          "field": "full_address",
          "label": "Address"
        },
        {
          "field": "research_notes",
          "label": "Why it belongs",
          "format": "preview",
          "previewMaxLength": 180
        },
        {
          "field": "next_action",
          "label": "Next step",
          "format": "preview",
          "previewMaxLength": 120
        }
      ],
      "layout": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 4
      },
      "style": {
        "accent": "sage"
      }
    },
    {
      "id": "review_rules",
      "kind": "text",
      "title": "A review status that means something",
      "content": "Unreviewed: source data only. Verify first: an important fact needs checking. Shortlisted: worth further research. Visited: your team completed a visit. Passed: your team chose to skip.\n\nA visit plan is not a booking. A public source is an observation, not a team decision. Keep the evidence behind your next step in research or verification notes.",
      "layout": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 3
      },
      "style": {
        "accent": "neutral"
      }
    }
  ]
}
