{
  "schemaVersion": 2,
  "moduleId": "gyri.module:fieldwork-public-context",
  "name": "Fieldwork public place context",
  "version": "0.1.0",
  "description": "On-demand live federation from selected places to nearby public business registrations, legacy businesses, static Muni stop inventory and analysis neighborhoods. No business records are copied or scored.",
  "tags": [
    "native",
    "federation",
    "places",
    "public-data",
    "socrata",
    "arcgis"
  ],
  "readme": "Install after Overture Fieldwork. On-demand source observations support research and field visits. Tax registration is not business openness; proximity is not entity matching; transit inventory is not real-time service; analysis neighborhoods are not official boundaries. DataSF datasets are PDDL 1.0; official Legacy Registry source exposes no explicit license, so federation retains attribution and no registry snapshot is redistributed.",
  "integrations": [
    {
      "integrationKey": "datasf_context",
      "kind": "http_rest",
      "provision": {
        "name": "DataSF public place context",
        "baseUrl": "https://data.sf.gov",
        "authMode": "none",
        "operations": [
          {
            "id": "nearby_registrations",
            "method": "GET",
            "pathTemplate": "/resource/g8m3-pdis.json",
            "requiredVariables": [
              "where",
              "select"
            ],
            "queryMap": {
              "where": "$where",
              "select": "$select",
              "offset": "$offset"
            },
            "queryStatic": {
              "$limit": "10",
              "$order": "distance_m ASC,uniqueid ASC"
            },
            "querySuppressVariablePassthrough": true,
            "mutating": false,
            "discovery": {
              "capabilityKey": "place.context.business_registration.nearby",
              "title": "Nearby city tax registrations",
              "description": "At most ten nearest public tax-location records within 100 metres; includes historic records; not an identity or openness guarantee.",
              "access": "read",
              "authority": "live",
              "freshness": "live",
              "outputConcept": "business_registration_live"
            }
          },
          {
            "id": "nearby_transit_stops",
            "method": "GET",
            "pathTemplate": "/resource/i28k-bkz6.json",
            "requiredVariables": [
              "where",
              "select"
            ],
            "queryMap": {
              "where": "$where",
              "select": "$select",
              "offset": "$offset"
            },
            "queryStatic": {
              "$limit": "8",
              "$order": "distance_m ASC,stopid ASC"
            },
            "querySuppressVariablePassthrough": true,
            "mutating": false,
            "discovery": {
              "capabilityKey": "place.context.transit_stop.nearby",
              "title": "Nearby Muni stop inventory",
              "description": "At most eight nearest stop inventory locations within 400 metres. This is the latest published static inventory, not current arrivals or walking accessibility.",
              "access": "read",
              "authority": "live",
              "freshness": "historical",
              "outputConcept": "transit_stop_live"
            }
          },
          {
            "id": "analysis_neighborhood",
            "method": "GET",
            "pathTemplate": "/resource/j2bu-swwd.json",
            "requiredVariables": [
              "where"
            ],
            "queryMap": {
              "where": "$where"
            },
            "queryStatic": {
              "$select": "nhood",
              "$limit": "2",
              "$order": "nhood ASC"
            },
            "querySuppressVariablePassthrough": true,
            "mutating": false,
            "discovery": {
              "capabilityKey": "place.context.neighborhood.containing",
              "title": "Containing analysis neighborhood",
              "description": "Static census-tract analysis grouping, not an official or legal neighborhood designation.",
              "access": "read",
              "authority": "live",
              "freshness": "historical",
              "outputConcept": "neighborhood_area_live"
            }
          },
          {
            "id": "dataset_metadata",
            "method": "GET",
            "pathTemplate": "/api/views/{{dataset_id}}.json",
            "requiredVariables": [
              "dataset_id"
            ],
            "querySuppressVariablePassthrough": true,
            "mutating": false,
            "discovery": {
              "capabilityKey": "open_data.source.metadata.read",
              "title": "DataSF dataset metadata",
              "access": "read",
              "authority": "live",
              "freshness": "live"
            }
          }
        ]
      }
    },
    {
      "integrationKey": "sf_legacy_context",
      "kind": "http_rest",
      "provision": {
        "name": "San Francisco Legacy Business Registry",
        "baseUrl": "https://services.arcgis.com/Zs2aNLFN00jrS4gG",
        "authMode": "none",
        "operations": [
          {
            "id": "nearby_legacy_businesses",
            "method": "GET",
            "pathTemplate": "/arcgis/rest/services/legacy_biz/FeatureServer/0/query",
            "requiredVariables": [
              "geometry"
            ],
            "queryMap": {
              "geometry": "geometry",
              "offset": "resultOffset"
            },
            "queryStatic": {
              "f": "json",
              "where": "Status IN ('Legacy Business: Active','Legacy Business: Active, In Transition')",
              "geometryType": "esriGeometryPoint",
              "inSR": "4326",
              "spatialRel": "esriSpatialRelIntersects",
              "distance": "500",
              "units": "esriSRUnit_Meter",
              "outSR": "4326",
              "outFields": "OBJECTID,Website_Business_Name,Location_Business_Name,Legacy_Business_Location__Street_Address,Business_Type,Neighborhood,Status,Established_Date,Business_Website",
              "returnGeometry": "true",
              "resultRecordCount": "8",
              "orderByFields": "OBJECTID ASC"
            },
            "querySuppressVariablePassthrough": true,
            "mutating": false,
            "discovery": {
              "capabilityKey": "place.context.community_business.nearby",
              "title": "Nearby official Legacy Business Registry places",
              "description": "At most eight registry locations within 500 metres, source status active or in transition. Nearby results do not establish this venue is a legacy business.",
              "access": "read",
              "authority": "live",
              "freshness": "live",
              "outputConcept": "community_business_live"
            }
          },
          {
            "id": "registry_metadata",
            "method": "GET",
            "pathTemplate": "/arcgis/rest/services/legacy_biz/FeatureServer/0",
            "queryStatic": {
              "f": "json"
            },
            "querySuppressVariablePassthrough": true,
            "mutating": false,
            "discovery": {
              "capabilityKey": "open_data.source.metadata.read",
              "title": "Official Legacy Registry layer metadata",
              "access": "read",
              "authority": "live",
              "freshness": "live"
            }
          }
        ]
      }
    }
  ],
