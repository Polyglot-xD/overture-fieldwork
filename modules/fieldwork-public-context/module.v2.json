  "bridges": [
    {
      "bridgeKey": "fieldwork_place_nearby_registrations",
      "fromTypeKey": "fieldwork_place",
      "edgeKind": "nearby_registrations",
      "strategy": "http_operation",
      "config": {
        "graphqlFieldKey": "nearbyRegistrations",
        "targetTypeKey": "business_registration_live",
        "integrationKey": "datasf_context",
        "operationId": "nearby_registrations",
        "isCollection": true,
        "responseMap": {
          "external_id": "uniqueid",
          "name": "dba_name",
          "address": "full_business_address",
          "city": "city",
          "region": "state",
          "postcode": "business_zip",
          "latitude": "location.coordinates.1",
          "longitude": "location.coordinates.0",
          "distance_m": "distance_m",
          "location_start_date": "location_start_date",
          "location_end_date": "location_end_date",
          "business_start_date": "dba_start_date",
          "business_end_date": "dba_end_date",
          "administratively_closed": "administratively_closed",
          "industry_code": "self_reported_naics_code",
          "business_corridor": "business_corridor",
          "neighborhood": "neighborhoods_analysis_boundaries",
          "data_as_of": "data_as_of",
          "source_loaded_at": "data_loaded_at",
          "source_url": {
            "literal": "https://data.sf.gov/d/g8m3-pdis"
          },
          "source_system": {
            "literal": "San Francisco Treasurer & Tax Collector / DataSF"
          }
        },
        "variableMap": {
          "where": {
            "template": "within_circle(location,${body.latitude},${body.longitude},100)"
          },
          "select": {
            "template": "uniqueid,dba_name,full_business_address,city,state,business_zip,location_start_date,location_end_date,dba_start_date,dba_end_date,administratively_closed,self_reported_naics_code,business_corridor,neighborhoods_analysis_boundaries,data_as_of,data_loaded_at,location,distance_in_meters(location,'POINT(${body.longitude} ${body.latitude})') AS distance_m"
          }
        },
        "requiredSourcePaths": [
          "body.latitude",
          "body.longitude"
        ],
        "includeRaw": false,
        "limit": 10,
        "agentNotes": "Read on explicit selected-place context request. Do not fetch for every place on initial page load. Nearby source rows are evidence candidates; never automatically merge identities or overwrite human review fields. Errors mean unavailable, not absence.",
        "rateLimits": [
          {
            "maxRequests": 3,
            "windowSeconds": 1,
            "scope": "workspace"
          },
          {
            "maxRequests": 500,
            "windowSeconds": 3600,
            "scope": "workspace"
          }
        ],
        "crossCluster": true
      }
    },
